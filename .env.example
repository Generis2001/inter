FOO=bar
# Tower credentials stay on the server. The existing read scope covers RPC;
# add swaps scope for swap quotes/builds. Never use VITE_TOWER_API_KEY.
TOWER_API_KEY=""
TOWER_PORT="8787"
# Comma-separated exact web, chrome-extension://<id>, and Android origins.
# For distributed unpacked extensions with varying IDs, opt in to chrome-extension://*.
TOWER_ALLOWED_ORIGINS="http://localhost:5173,https://localhost"
# Public HTTPS proxy origin for production web/extension/Android builds.
# Leave empty for Vite development, which provides /api/tower locally.
VITE_TOWER_PROXY_URL=""
RPC_PROXY_BASE_URL="https://studio.arc.io"
RPC_PROXY_TOKEN=""
RPC_PROXY_CHAINS="Ethereum,Arbitrum,Avalanche,Base,Optimism,Polygon,World_Chain,Celo,ZKSync_Era,Cronos,Plasma,Arc,Ethereum_Sepolia,Arbitrum_Sepolia,Avalanche_Fuji,Base_Sepolia,Optimism_Sepolia,Polygon_Amoy_Testnet,World_Chain_Sepolia,Celo_Alfajores_Testnet,ZKSync_Sepolia,Cronos_Testnet,Plasma_Testnet,Arc_Testnet"
